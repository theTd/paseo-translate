{
  "name": "paseo-translate-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "Paseo plugin: bilingual agent conversations via a translating ACP provider and timeline renderer",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "icon.svg"
  ],
  "scripts": {
    "build": "esbuild server/claude-provider.ts --bundle --platform=node --format=esm --target=node20 --outfile=server/claude-provider.dist.mjs --external:@getpaseo/plugin --external:@getpaseo/plugin/*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --bail=1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.246"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.9.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^20.9.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  }
}
